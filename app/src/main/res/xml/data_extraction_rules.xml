<?xml version="1.0" encoding="utf-8"?>
<!-- espn_leagues.json can hold an ESPN login cookie (espn_s2): never back it up or transfer it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="espn_leagues.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="espn_leagues.json" />
    </device-transfer>
</data-extraction-rules>
