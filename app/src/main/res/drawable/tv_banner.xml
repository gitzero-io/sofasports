<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV launcher banner: blue half (me) / red half (opponent). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp" android:height="180dp">
    <item android:right="160dp"><color android:color="#FF2F7DFF" /></item>
    <item android:left="160dp"><color android:color="#FFFF3D47" /></item>
    <item android:gravity="center" android:width="120dp" android:height="120dp"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
